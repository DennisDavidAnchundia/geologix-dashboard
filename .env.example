# GeoLogix — variables de entorno (copiar a .env y completar los secretos).
# NUNCA subir el .env real al repo.

# --- Base de datos ---
POSTGRES_USER=geologix
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=geologix

# --- Backend ---
# Secreto JWT (>=32 caracteres). OBLIGATORIO cambiarlo en prod.
SECURITY_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-1234567890
BACKEND_PORT=8080
# Orígenes extra separados por coma (solo si el frontend va en otro dominio, ej. S3).
# Vacío = mismo origen (nginx), recomendado.
CORS_ALLOWED_ORIGINS=

# --- Frontend ---
FRONTEND_PORT=80
# URLs absolutas SOLO si el frontend NO va tras el mismo nginx (ej. S3 + EC2).
# Vacío = mismo origen (/api y /ws relativos).
VITE_API_URL=
VITE_WS_URL=

# --- Demo gratis (Render + Supabase + Vercel) ---
# Supabase → JDBC con SSL (pooler puerto 6543 o directo 5432):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.XXXX.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USER=postgres
# SPRING_DATASOURCE_PASSWORD=tu-password-supabase
# Render → CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
# Vercel → VITE_API_URL=https://geologix-backend.onrender.com
# Vercel → VITE_WS_URL=wss://geologix-backend.onrender.com/ws
